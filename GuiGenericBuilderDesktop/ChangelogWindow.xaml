<Window x:Class="GuiGenericBuilderDesktop.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{DynamicResource ChangelogWindowTitle}" 
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- WebView2 for Markdown rendering -->
        <Border Grid.Row="0" 
                BorderBrush="#CCCCCC" 
                BorderThickness="1" 
                Margin="10,10,10,0"
                Background="White">
            <wv2:WebView2 x:Name="webView"/>
        </Border>

        <!-- Close Button -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#DDD" 
                BorderThickness="0,1,0,0" 
                Padding="10">
            <Button Content="{DynamicResource Close}"
                    Width="100"
                    Height="32"
                    HorizontalAlignment="Right"
                    Click="CloseButton_Click"
                    IsCancel="True"/>
        </Border>
    </Grid>
</Window>
